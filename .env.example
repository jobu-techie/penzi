FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-secret-key
DB_USER=techie
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_NAME=penzi

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-jwt-secret

# Admin login for /auth/admin-login.
# The hash is stored base64-encoded because it contains "$", which
# docker-compose's .env variable interpolation silently corrupts otherwise.
# Generate with:
#   python -c "
#   import base64
#   from werkzeug.security import generate_password_hash
#   h = generate_password_hash('your-admin-password')
#   print(base64.b64encode(h.encode()).decode())"
ADMIN_USERNAME=change-this-admin-username
ADMIN_PASSWORD_HASH_B64=change-this-generated-base64-hash

ONFON_API_KEY=your_onfon_api_key
ONFON_WEBHOOK_TOKEN=change-this-webhook-token
